# =============================================================================
# 随手学 kb-mcp 环境变量（示例）
#
# 使用方法：复制为 kb-mcp/.env（已在 .gitignore 中排除），
# 再删掉需要修改的那一行开头的 "# " 并填写：
#   cp .env.example .env
#
# 优先级：系统环境变量 > .env > config.yaml > 默认值
# 只有 SUISHOUXUE_ 开头的变量会被读取，其他内容一律忽略。
# 下面的条目默认都是注释，复制后不会改变任何设置。
# 不要把访问令牌、Git 凭据等秘密写进这个文件。
# =============================================================================

# --- Lite 版（基础设置）---
# SUISHOUXUE_CARDS_DIR=./cards
# SUISHOUXUE_PROFILES_DIR=../profiles
# SUISHOUXUE_DEFAULT_PROFILE=general

# --- Pro 版（可选）---
# Git 同步：cards_dir 需是独立的 Git 仓库。不要在这里放 token，认证用 SSH key 或 credential helper。
# SUISHOUXUE_SYNC_ENABLED=false
# SUISHOUXUE_SYNC_REMOTE=origin
# SUISHOUXUE_SYNC_BRANCH=main
# 静态站点：只发布带此标签的卡片
# SUISHOUXUE_PUBLISH_TAG=public

# --- Private 版（可选，仅 --transport http）---
# 令牌文件只存哈希；令牌本身不要写进任何配置文件
# SUISHOUXUE_TOKENS_FILE=./tokens.json
# SUISHOUXUE_HTTP_HOST=127.0.0.1
# SUISHOUXUE_HTTP_PORT=8765
# 监听非本机地址前，必须先配好 HTTPS 反向代理
# SUISHOUXUE_HTTP_ALLOW_REMOTE_BIND=false
# 你的域名（逗号分隔），用于防 DNS 重绑定
# SUISHOUXUE_ALLOWED_HOSTS=
